{
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["syd1"],
  "git": {
    "deploymentEnabled": false
  },
  "crons": [
    {
      "path": "/api/deal-sheet/reminders",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/deal-sheet/sync-refresh",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/deal-sheet/pre-warm",
      "schedule": "0 20 * * 0-4"
    },
    {
      "path": "/api/deal-sheet/pre-warm",
      "schedule": "0 21 * * 0-4"
    },
    {
      "path": "/api/deal-sheet/sync-report",
      "schedule": "0 8 * * 1-5"
    }
  ]
}

